# ── SmartIntern AI — SmartDoc Service ─────────────────────────────────────
# Copier ce fichier en .env et renseigner les valeurs

# Clé API Anthropic (obligatoire pour l'extraction IA de CVs)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Modèle Claude utilisé (optionnel, défaut : claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Port et hôte du service (optionnel)
SERVICE_PORT=8000
SERVICE_HOST=0.0.0.0

# Taille max des fichiers uploadés en MB (optionnel, défaut : 10)
MAX_FILE_SIZE_MB=10

# Dossier de sortie des documents générés (optionnel, défaut : outputs/)
OUTPUT_DIR=outputs
