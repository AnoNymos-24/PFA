{
  "id": "convention_stage",
  "type": "convention_stage",
  "name": "Convention de stage",
  "description": "Document légal tripartite entre l'étudiant, l'établissement et l'entreprise d'accueil.",
  "version": "1.0",
  "sections": [
    {
      "id": "etudiant",
      "title": "Informations sur l'étudiant",
      "fields": [
        { "id": "etudiant_nom",          "label": "Nom",                 "type": "text",   "required": true },
        { "id": "etudiant_prenom",       "label": "Prénom",              "type": "text",   "required": true },
        { "id": "etudiant_date_naissance","label": "Date de naissance",  "type": "date",   "required": true },
        { "id": "etudiant_nationalite",  "label": "Nationalité",         "type": "text",   "required": false },
        { "id": "etudiant_email",        "label": "Email",               "type": "text",   "required": true },
        { "id": "etudiant_telephone",    "label": "Téléphone",           "type": "text",   "required": false },
        { "id": "etudiant_filiere",      "label": "Filière",             "type": "text",   "required": true },
        { "id": "etudiant_niveau",       "label": "Niveau d'études",     "type": "select", "required": true,
          "options": ["Licence 1", "Licence 2", "Licence 3", "Master 1", "Master 2", "Ingénieur 1", "Ingénieur 2", "Ingénieur 3", "Doctorat"] }
      ]
    },
    {
      "id": "etablissement",
      "title": "Établissement d'enseignement",
      "fields": [
        { "id": "etab_nom",       "label": "Nom de l'établissement", "type": "text", "required": true },
        { "id": "etab_adresse",   "label": "Adresse",                "type": "text", "required": true },
        { "id": "etab_directeur", "label": "Nom du directeur",       "type": "text", "required": false }
      ]
    },
    {
      "id": "entreprise",
      "title": "Entreprise d'accueil",
      "fields": [
        { "id": "entreprise_nom",      "label": "Raison sociale",     "type": "text",     "required": true },
        { "id": "entreprise_adresse",  "label": "Adresse",            "type": "text",     "required": true },
        { "id": "entreprise_secteur",  "label": "Secteur d'activité", "type": "text",     "required": false },
        { "id": "entreprise_contact_nom",    "label": "Responsable (nom)", "type": "text","required": true },
        { "id": "entreprise_contact_poste",  "label": "Poste",             "type": "text","required": false },
        { "id": "entreprise_contact_email",  "label": "Email",             "type": "text","required": true },
        { "id": "entreprise_contact_tel",    "label": "Téléphone",         "type": "text","required": false }
      ]
    },
    {
      "id": "stage",
      "title": "Détails du stage",
      "fields": [
        { "id": "stage_intitule",      "label": "Intitulé du poste",   "type": "text",     "required": true },
        { "id": "stage_date_debut",    "label": "Date de début",       "type": "date",     "required": true },
        { "id": "stage_date_fin",      "label": "Date de fin",         "type": "date",     "required": true },
        { "id": "stage_duree_semaines","label": "Durée (semaines)",    "type": "number",   "required": true },
        { "id": "stage_lieu",          "label": "Lieu du stage",       "type": "text",     "required": false },
        { "id": "stage_remuneration",  "label": "Rémunération mensuelle (FCFA)", "type": "number", "required": false },
        { "id": "stage_objectifs",     "label": "Objectifs pédagogiques", "type": "textarea", "required": false }
      ]
    },
    {
      "id": "encadrants",
      "title": "Encadrants",
      "fields": [
        { "id": "enc_acad_nom",    "label": "Encadrant académique — Nom",    "type": "text", "required": false },
        { "id": "enc_acad_prenom", "label": "Encadrant académique — Prénom", "type": "text", "required": false },
        { "id": "enc_acad_grade",  "label": "Grade",                        "type": "text", "required": false },
        { "id": "enc_acad_email",  "label": "Email",                        "type": "text", "required": false },
        { "id": "enc_entr_nom",    "label": "Encadrant entreprise — Nom",   "type": "text", "required": false },
        { "id": "enc_entr_prenom", "label": "Encadrant entreprise — Prénom","type": "text", "required": false },
        { "id": "enc_entr_poste",  "label": "Poste",                        "type": "text", "required": false },
        { "id": "enc_entr_email",  "label": "Email",                        "type": "text", "required": false }
      ]
    }
  ]
}
