{
  "id": "attestation_stage",
  "type": "attestation_stage",
  "name": "Attestation de stage",
  "description": "Certificat officiel délivré par l'entreprise attestant la réalisation du stage.",
  "version": "1.0",
  "sections": [
    {
      "id": "entreprise",
      "title": "Entreprise délivrant l'attestation",
      "fields": [
        { "id": "entr_nom",            "label": "Raison sociale",             "type": "text", "required": true },
        { "id": "entr_adresse",        "label": "Adresse",                    "type": "text", "required": true },
        { "id": "entr_responsable_nom","label": "Nom du responsable",         "type": "text", "required": true },
        { "id": "entr_responsable_poste","label": "Poste du responsable",     "type": "text", "required": true },
        { "id": "entr_cachet",         "label": "Référence / cachet",         "type": "text", "required": false }
      ]
    },
    {
      "id": "stagiaire",
      "title": "Informations sur le stagiaire",
      "fields": [
        { "id": "etudiant_nom",         "label": "Nom",             "type": "text", "required": true },
        { "id": "etudiant_prenom",      "label": "Prénom",          "type": "text", "required": true },
        { "id": "etudiant_date_naissance","label": "Date de naissance","type": "date","required": false },
        { "id": "etudiant_etablissement","label": "Établissement",   "type": "text", "required": true },
        { "id": "etudiant_filiere",     "label": "Filière",          "type": "text", "required": true }
      ]
    },
    {
      "id": "stage",
      "title": "Détails du stage effectué",
      "fields": [
        { "id": "stage_intitule",   "label": "Intitulé du poste",  "type": "text", "required": true },
        { "id": "stage_date_debut", "label": "Date de début",      "type": "date", "required": true },
        { "id": "stage_date_fin",   "label": "Date de fin",        "type": "date", "required": true },
        { "id": "stage_lieu",       "label": "Lieu du stage",      "type": "text", "required": false },
        { "id": "date_attestation", "label": "Date de l'attestation","type": "date","required": true }
      ]
    }
  ]
}
