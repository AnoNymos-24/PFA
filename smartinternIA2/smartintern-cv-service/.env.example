# ── SmartIntern AI — CV Extraction & Document Service ──────────────────────

# Provider PRIMAIRE : NVIDIA NIM (Mistral Small 4 119B)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=mistralai/mistral-small-4-119b-2603
NVIDIA_MAX_TOKENS=16384

# Provider FALLBACK : OpenRouter (activé si NVIDIA retourne quota/rate-limit/erreur)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
# Plafond strict pour compte gratuit OpenRouter (1955 crédits dispo → on prend 1500 pour garder une marge)
OPENROUTER_MAX_TOKENS=1500

# Port et hôte du service
CV_SERVICE_PORT=8000
CV_SERVICE_HOST=0.0.0.0

# URL de base (pour les QR codes et liens de vérification)
BASE_URL=http://localhost:8000

# Clé secrète pour la signature HMAC des documentsSIGNATURE_SECRET=SmartIntern_SecretKey_ChangezMoi_2024
