# ════════════════════════════════════════════════════════════════════════
# SmartIntern AI Service — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs réelles.
# NE JAMAIS committer le fichier .env avec des valeurs réelles.
# ════════════════════════════════════════════════════════════════════════

# ── Service ───────────────────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ── Provider IA primaire : NVIDIA NIM ─────────────────────────────────────
# Obtenir une clé sur https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=mistralai/mistral-small-4-119b-2603
NVIDIA_MAX_TOKENS=16384

# ── Provider IA fallback : OpenRouter ─────────────────────────────────────
# Obtenir une clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_MAX_TOKENS=1500

# ── Stockage & fichiers ────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── Sécurité ──────────────────────────────────────────────────────────────
# Clé HMAC pour la signature des documents générés — changer en production !
SIGNATURE_SECRET=remplacez-par-une-cle-aleatoire-longue

# ── URL de base (QR codes et liens de vérification) ───────────────────────
BASE_URL=http://localhost:8000
